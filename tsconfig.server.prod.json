{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "UMD",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "sourceMap": false
  },
  "include": [
    "src/server.ts",
    "src/utils/**/*.ts",
    "src/users/**/*.ts",
    "src/types/**/*.ts"
  ]
}